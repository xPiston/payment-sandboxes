# Monetico issues these three per point of sale, and they differ between the
# sandbox and production. Never commit the real ones: this file is the example,
# `.env` is ignored.
MONETICO_TERMINAL=1234567
MONETICO_KEY=0123456789ABCDEF0123456789ABCDEF01234567
MONETICO_COMPANY=monSite1

# The public hostname Monetico can reach, when a tunnel is in front of this.
# The notification URL is registered with the contract, not sent in the form.
# SANDBOX_BASE_URL=https://sandbox.example.test
